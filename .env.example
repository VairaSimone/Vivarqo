# LOCAL DEVELOPMENT ONLY. Production/staging use separate environment files and mounted secrets.
NODE_ENV=development
PORT=3000
# Number of trusted reverse proxies in front of the API; keep 0 unless deployment topology is known.
TRUST_PROXY_HOPS=0
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://vivarqo:vivarqo_dev@localhost:5432/vivarqo?schema=public
# Host-side port used by Docker Compose; the container continues to listen on 5432.
VIVARQO_POSTGRES_HOST_PORT=5432

# Segnaposto non segreti: sostituirli tramite l'ambiente prima di abilitare i relativi moduli.
CSRF_SECRET=replace-with-another-32-bytes-of-random-secret
EMAIL_PROVIDER=brevo
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=noreply@example.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Billing remains free/unrestricted until a commercial plan is launched.
BILLING_ACCESS_MODE=unrestricted
BILLING_PAST_DUE_GRACE_DAYS=7
# Zero means unlimited; configure positive values to enforce free-plan quotas.
BILLING_FREE_MAX_ANIMALS=0
BILLING_FREE_MAX_DOCUMENTS=0
BILLING_FREE_MAX_STORAGE_BYTES=0
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
S3_ENDPOINT=
S3_REGION=eu-west-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SENTRY_DSN=
# Segreto casuale di almeno 32 caratteri per proteggere l'endpoint Prometheus /metrics.
METRICS_BEARER_TOKEN=

# Percorso privato persistente per documenti ed esportazioni in sviluppo
PRIVATE_STORAGE_PATH=./var/private

# Limiti ZIP64 per gli export (dimensione in byte e numero di elementi).
EXPORT_MAX_ARCHIVE_BYTES=21474836480
EXPORT_MAX_ENTRIES=100000
