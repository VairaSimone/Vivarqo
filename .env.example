NODE_ENV=development
PORT=3000
# Number of trusted reverse proxies in front of the API; keep 0 unless deployment topology is known.
TRUST_PROXY_HOPS=0
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://vivarqo:vivarqo_dev@localhost:5432/vivarqo?schema=public

# Segnaposto non segreti: sostituirli tramite l'ambiente prima di abilitare i relativi moduli.
CSRF_SECRET=replace-with-another-32-bytes-of-random-secret
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
S3_ENDPOINT=
S3_REGION=eu-west-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Segreto casuale di almeno 32 caratteri per proteggere l'endpoint Prometheus /metrics.
METRICS_BEARER_TOKEN=

# Percorso privato persistente per documenti ed esportazioni in sviluppo
PRIVATE_STORAGE_PATH=./var/private
