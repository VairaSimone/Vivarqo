# Staging non-secret settings only. Use a separate staging secret directory and data volumes.
VIVARQO_ENV_FILE=../../../.env.staging
COMPOSE_PROJECT_NAME=vivarqo-staging
VIVARQO_NODE_ENV=staging
VIVARQO_SECRETS_DIR=/etc/vivarqo/staging/secrets
VIVARQO_BACKUP_DIR=/mnt/vivarqo-staging-backups

PUBLIC_DOMAIN=staging.example.com
ACME_EMAIL=ops@example.com
APP_ORIGIN=https://staging.example.com
API_ORIGIN=https://staging.example.com
TRUST_PROXY_HOPS=2

DATABASE_NAME=vivarqo_staging
DATABASE_ADMIN_USER=vivarqo_staging_admin
DATABASE_USER=vivarqo_staging_app
DATABASE_BACKUP_USER=vivarqo_staging_backup
DATABASE_PORT=5432
EMAIL_FROM=staging-noreply@example.com

STRIPE_PRICE_ID=price_replace_with_test_price_id
VAPID_PUBLIC_KEY=replace_with_staging_vapid_public_key
VAPID_SUBJECT=mailto:staging-ops@example.com
S3_ENDPOINT=
S3_REGION=eu-west-1
S3_BUCKET=replace_with_private_staging_bucket
SENTRY_DSN=

PRIVATE_STORAGE_PATH=/app/var/private
EXPORT_MAX_ARCHIVE_BYTES=21474836480
EXPORT_MAX_ENTRIES=100000
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
