    "build": "pnpm build:service-worker && pnpm typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "vite": "^7.3.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
