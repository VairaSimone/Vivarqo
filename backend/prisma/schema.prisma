model AnimalTransfer {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  animalId String @map("animal_id") @db.Uuid
  transferType String @map("transfer_type") @db.VarChar(16)
  recipientName String @map("recipient_name") @db.VarChar(160)
  recipientEmail String? @map("recipient_email") @db.VarChar(254)
  recipientBreeder String? @map("recipient_breeder") @db.VarChar(160)
  transferredAt DateTime @map("transferred_at") @db.Timestamptz(6)
  priceCents BigInt? @map("price_cents")
  notes String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
