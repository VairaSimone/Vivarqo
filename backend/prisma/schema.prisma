  animalId    String    @map("animal_id") @db.Uuid
  kind        String    @db.VarChar(32)
  title       String    @db.VarChar(160)
  occurredAt  DateTime  @map("occurred_at") @db.Timestamptz(6)
  nextDueAt   DateTime? @map("next_due_at") @db.Timestamptz(6)
  provider    String?   @db.VarChar(160)
  dosage      String?   @db.VarChar(120)
  frequency   String?   @db.VarChar(120)
  notes       String?
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  animal      Animal    @relation(fields: [animalId], references: [id], onDelete: Cascade)
  task        Task?
  clinic      String?   @db.VarChar(160)
  treatmentStartAt DateTime? @map("treatment_start_at") @db.Timestamptz(6)
  treatmentEndAt DateTime? @map("treatment_end_at") @db.Timestamptz(6)
  isOngoing   Boolean   @default(false) @map("is_ongoing")
  @@index([userId, deletedAt, nextDueAt], map: "companion_care_user_due_idx")
  @@index([animalId, occurredAt(sort: Desc)], map: "companion_care_animal_occurred_idx")
  @@map("companion_care_records")
}

model PushDeliveryAttempt {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  notificationId     String?           @map("notification_id") @db.Uuid
  pushSubscriptionId String?           @map("push_subscription_id") @db.Uuid
  deliveryKey        String            @map("delivery_key") @db.VarChar(180)
  attemptNumber      Int               @map("attempt_number")
  status             String            @default("queued") @db.VarChar(24)
  scheduledAt        DateTime          @default(now()) @map("scheduled_at") @db.Timestamptz(6)
  attemptedAt        DateTime?         @map("attempted_at") @db.Timestamptz(6)
  sentAt             DateTime?         @map("sent_at") @db.Timestamptz(6)
  nextAttemptAt      DateTime?         @map("next_attempt_at") @db.Timestamptz(6)
  httpStatus         Int?              @map("http_status")
  errorCode          String?           @map("error_code") @db.VarChar(80)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification       Notification?     @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  pushSubscription   PushSubscription? @relation(fields: [pushSubscriptionId], references: [id], onDelete: SetNull)

  @@unique([deliveryKey, attemptNumber], map: "push_delivery_attempts_delivery_attempt_unique")
  @@index([status, scheduledAt], map: "push_delivery_attempts_status_scheduled_idx")
  @@index([userId, createdAt(sort: Desc)], map: "push_delivery_attempts_user_created_idx")
  @@index([notificationId], map: "push_delivery_attempts_notification_idx")
  @@map("push_delivery_attempts")
}


model AnimalLocation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  parentId String? @map("parent_id") @db.Uuid
  kind String @db.VarChar(16)
  name String @db.VarChar(120)
  sortOrder Int @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent AnimalLocation? @relation("AnimalLocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children AnimalLocation[] @relation("AnimalLocationTree")
  animals Animal[]
  movesFrom AnimalLocationMove[] @relation("AnimalLocationMoveFrom")
  movesTo AnimalLocationMove[] @relation("AnimalLocationMoveTo")
  @@unique([id,userId], map: "animal_locations_id_user_id_unique")
  @@index([userId,parentId,sortOrder], map: "animal_locations_user_parent_sort_idx")
  @@index([userId,kind], map: "animal_locations_user_kind_idx")
  @@map("animal_locations")
}
model AnimalLocationMove {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  animalId String @map("animal_id") @db.Uuid
  fromLocationId String? @map("from_location_id") @db.Uuid
  toLocationId String? @map("to_location_id") @db.Uuid
  movedAt DateTime @default(now()) @map("moved_at") @db.Timestamptz(6)
  reason String? @db.VarChar(500)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
  fromLocation AnimalLocation? @relation("AnimalLocationMoveFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation AnimalLocation? @relation("AnimalLocationMoveTo", fields: [toLocationId], references: [id], onDelete: SetNull)
  @@index([userId,movedAt(sort: Desc)], map: "animal_location_moves_user_moved_idx")
  @@index([animalId,movedAt(sort: Desc)], map: "animal_location_moves_animal_moved_idx")
  @@map("animal_location_moves")
}
model SavedAnimalFilter {
