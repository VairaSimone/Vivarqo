generator client {
  provider        = "prisma-client"
  output          = "../api/src/generated/prisma"
  previewFeatures = ["postgresqlExtensions", "partialIndexes"]
}
datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

model User {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                   String                    @unique @db.Citext
  passwordHash            String                    @map("password_hash")
  displayName             String                    @map("display_name") @db.VarChar(120)
  locale                  String                    @default("it") @db.VarChar(10)
  timezone                String                    @default("Europe/Rome") @db.VarChar(64)
  emailVerifiedAt         DateTime?                 @map("email_verified_at") @db.Timestamptz(6)
  termsAcceptedAt         DateTime?                 @map("terms_accepted_at") @db.Timestamptz(6)
  termsVersion            String?                   @map("terms_version") @db.VarChar(32)
  accountStatus           String                    @default("active") @map("account_status") @db.VarChar(20)
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime?                 @map("deleted_at") @db.Timestamptz(6)
  sessions                UserSession[]
  authTokens              AuthToken[]
  animals                 Animal[]
  animalLocations         AnimalLocation[]
  animalLocationMoves     AnimalLocationMove[]
  savedAnimalFilters      SavedAnimalFilter[]
  animalTransfers         AnimalTransfer[]
  feedingSessions         FeedingSession[]
  reminderRules           ReminderRule[]
  tasks                   Task[]
  notificationPreferences NotificationPreferences?
  userPreference           UserPreference?
  accountConfiguration    AccountConfiguration?
  aquariums               Aquarium[]
  aviaries                Aviary[]
  birdProfiles            BirdProfile[]
  birdBreedingPairs       BirdBreedingPair[]
  companionCareRecords    CompanionCareRecord[]
  pushSubscriptions       PushSubscription[]
  pushDeliveryAttempts    PushDeliveryAttempt[]
  notifications           Notification[]
  reproductionCycles      ReproductionCycle[]
  incubators              Incubator[]
  breedingProfiles        SpeciesBreedingProfile[]
  inventoryItems          InventoryItem[]
  inventorySuppliers      InventorySupplier[]
  documents               Document[]
  documentDeletionJobs    DocumentDeletionJob[]
  publicShares            PublicShare[]
  importJobs              ImportJob[]
  exportJobs              ExportJob[]
  financeEntries          FinanceEntry[]
  financeBudgets          FinanceBudget[]
  financeRecurrences      FinanceRecurrence[]
  subscription            Subscription?
  auditEvents             AuditEvent[]
  geneticGenes            GeneticGene[]
  geneticHistoryChanges   AnimalGeneticTraitHistory[] @relation("GeneticHistoryChangedBy")
  ownedWorkspaceMemberships WorkspaceMembership[] @relation("WorkspaceOwner")
  collaboratorMemberships WorkspaceMembership[] @relation("WorkspaceCollaborator")
  ownedWorkspaceInvitations WorkspaceInvitation[] @relation("WorkspaceInvitationOwner")
  activeWorkspaceSessions UserSession[] @relation("SessionActiveWorkspace")
  @@map("users")
}

model WorkspaceMembership {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId String @map("owner_user_id") @db.Uuid
  collaboratorUserId String @map("collaborator_user_id") @db.Uuid
  role String @db.VarChar(24)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  owner User @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  collaborator User @relation("WorkspaceCollaborator", fields: [collaboratorUserId], references: [id], onDelete: Cascade)
  @@unique([ownerUserId, collaboratorUserId], map: "workspace_memberships_owner_collaborator_key")
  @@index([collaboratorUserId, revokedAt], map: "workspace_memberships_collaborator_revoked_idx")
  @@index([ownerUserId, revokedAt], map: "workspace_memberships_owner_revoked_idx")
  @@map("workspace_memberships")
}

model WorkspaceInvitation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId String @map("owner_user_id") @db.Uuid
  email String @db.Citext
  tokenHash String @unique @map("token_hash") @db.VarChar(128)
  role String @db.VarChar(24)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  owner User @relation("WorkspaceInvitationOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  @@unique([ownerUserId, email], where: raw("(\"accepted_at\" IS NULL) AND (\"revoked_at\" IS NULL)"), map: "workspace_invitations_pending_owner_email_key")
  @@index([ownerUserId, expiresAt], map: "workspace_invitations_owner_expires_idx")
  @@index([email, expiresAt], map: "workspace_invitations_email_expires_idx")
  @@map("workspace_invitations")
}

model UserSession {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  userAgent  String?  @map("user_agent")
  ipHash     String?  @map("ip_hash")
  activeWorkspaceOwnerId String? @map("active_workspace_owner_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeWorkspaceOwner User? @relation("SessionActiveWorkspace", fields: [activeWorkspaceOwnerId], references: [id], onDelete: SetNull)
  @@index([activeWorkspaceOwnerId], map: "user_sessions_active_workspace_idx")
  @@index([userId, expiresAt], map: "user_sessions_user_expires_idx")
  @@index([expiresAt], map: "user_sessions_expires_idx")
  @@map("user_sessions")
}

model AuthToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  tokenType  String    @map("token_type") @db.VarChar(24)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, tokenType, expiresAt], map: "auth_tokens_user_type_expires_idx")
  @@index([expiresAt], map: "auth_tokens_expires_idx")
  @@map("auth_tokens")
}

model Animal {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String                @map("user_id") @db.Uuid
  name                   String                @db.VarChar(120)
  identifier             String?               @db.Citext
  species                String                @db.VarChar(160)
  sex                    String                @default("unknown") @db.VarChar(12)
  category               String                @default("reptiles") @db.VarChar(24)
  domainProfile          Json?                 @map("domain_profile") @db.JsonB
  morph                  String?               @db.VarChar(200)
  motherAnimalId         String?               @map("mother_animal_id") @db.Uuid
  fatherAnimalId         String?               @map("father_animal_id") @db.Uuid
  motherDescription      String?               @map("mother_description") @db.VarChar(240)
  fatherDescription      String?               @map("father_description") @db.VarChar(240)
  geneticsNotes          String?               @map("genetics_notes")
  birthDate              DateTime?             @map("birth_date") @db.Date
  birthDateEstimated     Boolean               @default(false) @map("birth_date_estimated")
  acquiredDate           DateTime?             @map("acquired_date") @db.Date
  originDescription      String?               @map("origin_description")
  previousBreeder        String?               @map("previous_breeder") @db.VarChar(160)
  locationLabel          String?               @map("location_label") @db.VarChar(160)
  locationId             String?               @map("location_id") @db.Uuid
  feedingIntervalDays    Int?                  @map("feeding_interval_days")
  qrToken                String?               @unique(map: "animals_qr_token_unique") @map("qr_token") @db.VarChar(64)
  status                 String                @default("active") @db.VarChar(20)
  notes                  String?
  photoKey               String?               @map("photo_key")
  originClutchId         String?               @map("origin_clutch_id") @db.Uuid
  originOffspringBatchId String?               @map("origin_offspring_batch_id") @db.Uuid
  archivedAt             DateTime?             @map("archived_at") @db.Timestamptz(6)
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  location               AnimalLocation?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  locationMoves          AnimalLocationMove[]
  transfers              AnimalTransfer[]
  mother                 Animal?               @relation("AnimalMother", fields: [motherAnimalId], references: [id], onDelete: SetNull)
  father                 Animal?               @relation("AnimalFather", fields: [fatherAnimalId], references: [id], onDelete: SetNull)
  childrenAsMother       Animal[]              @relation("AnimalMother")
  childrenAsFather       Animal[]              @relation("AnimalFather")
  feedingEntries         FeedingEntry[]
  weightMeasurements     WeightMeasurement[]
  shedRecords            ShedRecord[]
  notesHistory           AnimalNote[]
  reminderRules          ReminderRule[]
  tasks                  Task[]
  parentCyclesA          ReproductionCycle[]   @relation("CycleParentA")
  parentCyclesB          ReproductionCycle[]   @relation("CycleParentB")
  reproductiveEvents     ReproductiveEvent[]
  originClutch           Clutch?               @relation("AnimalOriginClutch", fields: [originClutchId], references: [id], onDelete: Restrict)
  originOffspringBatch   OffspringBatch?       @relation("AnimalOriginBatch", fields: [originOffspringBatchId], references: [id], onDelete: Restrict)
  documents              Document[]
  healthRecords          HealthRecord[]
  publicShare            PublicShare?
  financeEntries         FinanceEntry[]
  geneticTraits          AnimalGeneticTrait[]  @relation("GeneticTraitAnimal")
  traitsAsSource         AnimalGeneticTrait[]  @relation("GeneticTraitSourceAnimal")
  geneticTraitHistory    AnimalGeneticTraitHistory[]
  hatchlingCare          HatchlingCare?
  hatchedEgg             Egg?                  @relation("EggOffspring")
  aviaryAssignments      AviaryBird[]
  birdProfile            BirdProfile?
  breedingPairsAsFemale  BirdBreedingPair[] @relation("BirdPairFemale")
  breedingPairsAsMale    BirdBreedingPair[] @relation("BirdPairMale")
  aviaryMovements        AviaryMovement[]
  companionCareRecords   CompanionCareRecord[]
  @@unique([id, userId], map: "animals_id_user_id_unique")
  @@unique([userId, identifier], where: raw("\"identifier\" IS NOT NULL"), map: "animals_user_identifier_unique")
  @@index([userId, category, status], map: "animals_user_category_status_idx")
  @@index([userId, status], map: "animals_user_status_idx")
  @@index([userId, name], map: "animals_user_name_idx")
  @@index([userId, species], map: "animals_user_species_idx")
  @@index([motherAnimalId], map: "animals_mother_idx")
  @@index([fatherAnimalId], map: "animals_father_idx")
  @@index([userId, locationLabel], map: "animals_user_location_idx")
  @@index([originClutchId], map: "animals_origin_clutch_idx")
  @@index([originOffspringBatchId], map: "animals_origin_batch_idx")
  @@map("animals")
}

model FeedingSession {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  performedAt DateTime       @map("performed_at") @db.Timestamptz(6)
  notes       String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries     FeedingEntry[]
  @@unique([id, userId], map: "feeding_sessions_id_user_id_unique")
  @@index([userId, performedAt(sort: Desc)], map: "feeding_sessions_user_performed_idx")
  @@map("feeding_sessions")
}

model FeedingEntry {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId   String         @map("session_id") @db.Uuid
  animalId    String         @map("animal_id") @db.Uuid
  outcome     String         @db.VarChar(20)
  foodType    String?        @map("food_type") @db.VarChar(120)
  foodSize    String?        @map("food_size") @db.VarChar(120)
  foodWeightG Decimal?       @map("food_weight_g") @db.Decimal(10, 2)
  preyState   String          @default("unknown") @map("prey_state") @db.VarChar(16)
  inventoryItemId String?    @map("inventory_item_id") @db.Uuid
  inventoryQuantity Decimal? @map("inventory_quantity") @db.Decimal(12, 3)
  inventoryDeducted Boolean  @default(false) @map("inventory_deducted")
  notes       String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  session     FeedingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  animal      Animal         @relation(fields: [animalId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  @@index([inventoryItemId], map: "feeding_entries_inventory_item_idx")
  @@index([animalId, outcome], map: "feeding_entries_animal_outcome_idx")
  @@index([animalId, sessionId], map: "feeding_entries_animal_session_idx")
  @@index([sessionId], map: "feeding_entries_session_idx")
  @@map("feeding_entries")
}

model WeightMeasurement {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  animalId   String   @map("animal_id") @db.Uuid
  measuredAt DateTime @map("measured_at") @db.Timestamptz(6)
  weightG    Decimal  @map("weight_g") @db.Decimal(10, 2)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  animal     Animal   @relation(fields: [animalId], references: [id], onDelete: Restrict)
  @@index([animalId, measuredAt(sort: Desc)], map: "weight_measurements_animal_measured_idx")
  @@map("weight_measurements")
}

model ShedRecord {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  animalId   String   @map("animal_id") @db.Uuid
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  outcome    String   @db.VarChar(16)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  animal     Animal   @relation(fields: [animalId], references: [id], onDelete: Restrict)
  @@index([animalId, occurredAt(sort: Desc)], map: "shed_records_animal_occurred_idx")
  @@map("shed_records")
}

model AnimalNote {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  animalId   String   @map("animal_id") @db.Uuid
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  title      String?  @db.VarChar(160)
  category   String   @db.VarChar(40)
  body       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  animal     Animal   @relation(fields: [animalId], references: [id], onDelete: Restrict)
  @@index([animalId, occurredAt(sort: Desc)], map: "animal_notes_animal_occurred_idx")
  @@map("animal_notes")
}

model ReminderRule {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  animalId     String?   @map("animal_id") @db.Uuid
  title        String    @db.VarChar(160)
  description  String?
  category     String    @db.VarChar(30)
  intervalDays Int       @map("interval_days")
  nextDueAt    DateTime  @map("next_due_at") @db.Timestamptz(6)
  isEnabled    Boolean   @default(true) @map("is_enabled")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  animal       Animal?   @relation(fields: [animalId], references: [id], onDelete: Restrict)
  tasks        Task[]
  @@unique([id, userId], map: "reminder_rules_id_user_id_unique")
  @@index([userId, nextDueAt], where: { isEnabled: true }, map: "reminder_rules_user_next_due_idx")
  @@index([animalId], map: "reminder_rules_animal_idx")
  @@map("reminder_rules")
}

model Task {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  animalId       String?       @map("animal_id") @db.Uuid
  title          String        @db.VarChar(160)
  description    String?
  category       String        @db.VarChar(30)
  dueAt          DateTime      @map("due_at") @db.Timestamptz(6)
  status         String        @default("open") @db.VarChar(16)
  completedAt    DateTime?     @map("completed_at") @db.Timestamptz(6)
  reminderRuleId String?       @map("reminder_rule_id") @db.Uuid
  healthRecordId String?       @unique @map("health_record_id") @db.Uuid
  companionCareRecordId String? @unique @map("companion_care_record_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  animal         Animal?       @relation(fields: [animalId], references: [id], onDelete: Restrict)
  reminderRule   ReminderRule? @relation(fields: [reminderRuleId], references: [id], onDelete: SetNull)
  healthRecord   HealthRecord? @relation(fields: [healthRecordId], references: [id], onDelete: Cascade)
  companionCareRecord CompanionCareRecord? @relation(fields: [companionCareRecordId], references: [id], onDelete: Cascade)
  @@index([userId, status, dueAt], map: "tasks_user_status_due_idx")
  @@index([animalId], map: "tasks_animal_idx")
  @@index([reminderRuleId], map: "tasks_reminder_rule_idx")
  @@unique([reminderRuleId], where: raw("\"status\" = 'open'"), map: "tasks_one_open_per_reminder_rule_idx")
  @@map("tasks")
}

model NotificationPreferences {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  inAppEnabled    Boolean  @default(true) @map("in_app_enabled")
  pushEnabled     Boolean  @default(false) @map("push_enabled")
  categories      Json     @default("{}") @db.JsonB
  quietHoursStart DateTime? @map("quiet_hours_start") @db.Time(6)
  quietHoursEnd   DateTime? @map("quiet_hours_end") @db.Time(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("notification_preferences")
}

model PushSubscription {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  endpoint      String    @unique
  p256dh        String
  authSecret    String    @map("auth_secret")
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(6)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryAttempts PushDeliveryAttempt[]
  @@index([userId], map: "push_subscriptions_user_idx")
  @@map("push_subscriptions")
}

model Notification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  category   String    @db.VarChar(30)
  title      String    @db.VarChar(160)
  body       String
  targetPath String?   @map("target_path")
  readAt     DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushDeliveryAttempts PushDeliveryAttempt[]
  @@index([userId, createdAt(sort: Desc)], map: "notifications_user_created_idx")
  @@index([userId, createdAt(sort: Desc)], where: { readAt: null }, map: "notifications_user_unread_idx")
  @@map("notifications")
}

model ReproductionCycle {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  parentAAnimalId   String?            @map("parent_a_animal_id") @db.Uuid
  parentBAnimalId   String?            @map("parent_b_animal_id") @db.Uuid
  name              String?            @db.VarChar(160)
  startedOn         DateTime           @map("started_on") @db.Date
  endedOn           DateTime?          @map("ended_on") @db.Date
  status            String             @default("planned") @db.VarChar(16)
  notes             String?
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentA           Animal?            @relation("CycleParentA", fields: [parentAAnimalId], references: [id], onDelete: Restrict)
  parentB           Animal?            @relation("CycleParentB", fields: [parentBAnimalId], references: [id], onDelete: Restrict)
  events            ReproductiveEvent[]
  clutches          Clutch[]
  offspringBatches  OffspringBatch[]
  documents         Document[]
  birdPair          BirdBreedingPair?
  @@unique([id, userId], map: "reproduction_cycles_id_user_id_unique")
  @@index([userId, status, startedOn(sort: Desc)], map: "reproduction_cycles_user_status_started_idx")
  @@index([parentAAnimalId], map: "reproduction_cycles_parent_a_idx")
  @@index([parentBAnimalId], map: "reproduction_cycles_parent_b_idx")
  @@map("reproduction_cycles")
}

model ReproductiveEvent {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycleId      String            @map("cycle_id") @db.Uuid
  eventType    String            @map("event_type") @db.VarChar(24)
  occurredAt   DateTime          @map("occurred_at") @db.Timestamptz(6)
  animalId     String?           @map("animal_id") @db.Uuid
  details      String?
  temperatureC Decimal?          @map("temperature_c") @db.Decimal(5, 2)
  humidityPct  Decimal?          @map("humidity_pct") @db.Decimal(5, 2)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  cycle        ReproductionCycle  @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  animal       Animal?            @relation(fields: [animalId], references: [id], onDelete: Restrict)
  @@index([cycleId, occurredAt], map: "reproductive_events_cycle_occurred_idx")
  @@index([animalId], map: "reproductive_events_animal_idx")
  @@map("reproductive_events")
}

model Clutch {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycleId             String             @map("cycle_id") @db.Uuid
