# Production non-secret settings only. Real secrets live in VIVARQO_SECRETS_DIR.
VIVARQO_ENV_FILE=../../../.env.production
COMPOSE_PROJECT_NAME=vivarqo-prod
VIVARQO_NODE_ENV=production
VIVARQO_SECRETS_DIR=/etc/vivarqo/prod/secrets
VIVARQO_BACKUP_DIR=/mnt/vivarqo-prod-backups

PUBLIC_DOMAIN=app.example.com
ACME_EMAIL=ops@example.com
APP_ORIGIN=https://app.example.com
API_ORIGIN=https://app.example.com
TRUST_PROXY_HOPS=2

DATABASE_NAME=vivarqo
DATABASE_ADMIN_USER=vivarqo_admin
DATABASE_USER=vivarqo_app
DATABASE_PORT=5432
EMAIL_FROM=noreply@example.com

STRIPE_PRICE_ID=price_replace_with_live_price_id
VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_SUBJECT=mailto:ops@example.com
S3_ENDPOINT=
S3_REGION=eu-west-1
S3_BUCKET=replace_with_private_production_bucket
SENTRY_DSN=

PRIVATE_STORAGE_PATH=/app/var/private
EXPORT_MAX_ARCHIVE_BYTES=21474836480
EXPORT_MAX_ENTRIES=100000
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400
